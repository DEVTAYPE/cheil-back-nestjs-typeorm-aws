# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# AWS RDS
# Formato: postgresql://USER:PASSWORD@RDS_ENDPOINT:5432/DATABASE
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@your-rds-endpoint.rds.amazonaws.com:5432/cheil_db"

# JWT
# Generar con: openssl rand -hex 32
JWT_SECRET="replace_with_64_char_random_string"
JWT_EXPIRES_IN="1d"

# CORS 
# EC2 frontend IP o dominio
CORS_ORIGINS="http://YOUR_FRONTEND_EC2_IP"

# ─── AWS S3 opcional
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
AWS_S3_BUCKET=cheil-productos-images

# ─── AWS SES opcional
AWS_SES_FROM_EMAIL=noreply@yourdomain.com
AWS_SES_ADMIN_EMAIL=admin@yourdomain.com
